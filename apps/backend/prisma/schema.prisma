generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  avatar       String
  email        String    @unique
  password     String?
  googleId     String?   @unique
  otp          String?
  otpExpiry    DateTime?
  otpVerified  Boolean   @default(false)
  dob          DateTime?
  pin          String?
  refreshToken String?
  // Forgot-password flow: a bcrypt-hashed 6-digit code, cleared once used.
  resetCodeHash    String?
  resetCodeExpiry  DateTime?
  resetAttempts    Int       @default(0)
  resetRequestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Daily-login streak - advanced only on explicit logins (see recordLogin),
  // not on silent token refreshes.
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastLoginDate DateTime? @db.Date
  // Monday's "your week" recap email (services/weeklyRecap.ts). On by default, off in profile settings.
  weeklyRecapEmails Boolean @default(true)

  wallet                Wallet?
  holdings              Holding[]
  transactions          Transaction[]
  queuedOrders          QueuedOrder[]
  contestEntries        ContestEntry[]
  ownedContests         Contest[]        @relation("ContestOwner")
  priceAlerts           PriceAlert[]
  watchlist             WatchlistItem[]
  dailySnapshots        DailySnapshot[]
  questCompletions      QuestCompletion[]
  practiceSessions      PracticeSession[]
  predictions           Prediction[]
  following             Follow[]         @relation("Following")
  followers             Follow[]         @relation("Followers")
  notificationsReceived Notification[]   @relation("NotificationRecipient")
  notificationsCaused   Notification[]   @relation("NotificationActor")
  weeklySnapshots       WeeklySnapshot[]
  badges                UserBadge[]
}

// Earned records only - badge definitions (name/description/icon) live in
// services/achievements.ts, looked up by badgeId, so adding/editing a badge
// never needs a migration.
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

// One row per user per completed week - written by the weekly reset job
// right before it force-liquidates holdings and resets the wallet back to
// STARTING_BALANCE, so profiles can show a "how did last week go" history.
model WeeklySnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  weekStart    DateTime
  weekEnd      DateTime
  startBalance Decimal  @db.Decimal(18, 2)
  endNetWorth  Decimal  @db.Decimal(18, 2)
  pnlPercent   Decimal  @db.Decimal(10, 4)
  createdAt    DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

enum NotificationType {
  FOLLOW
  ACHIEVEMENT
  ORDER
  CONTEST
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id])
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id])
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

enum Side {
  BUY
  SELL
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(100000) @db.Decimal(18, 2)
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holding {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  symbol      String
  quantity    Int
  avgBuyPrice Decimal  @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, symbol])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbol    String
  side      Side
  quantity  Int
  price     Decimal  @db.Decimal(18, 4)
  total     Decimal  @db.Decimal(18, 2) // price x quantity, before charges
  charges   Decimal  @default(0) @db.Decimal(18, 2) // services/charges.ts
  note      String?  @db.VarChar(500) // the player's trade-journal entry
  createdAt DateTime @default(now())
}

enum QueuedOrderStatus {
  PENDING
  FILLED
  CANCELLED
  FAILED
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

// A main-wallet order waiting to fill (jobs/queuedOrders.ts). MARKET orders
// were placed while the market was closed and fill at the first live price
// after the open. LIMIT and STOP orders wait until the price reaches
// triggerPrice. quotedPrice is only the last price the user saw.
model QueuedOrder {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  symbol        String
  side          Side
  quantity      Int
  quotedPrice   Decimal           @db.Decimal(18, 4)
  orderType     OrderType         @default(MARKET)
  triggerPrice  Decimal?          @db.Decimal(18, 4)
  status        QueuedOrderStatus @default(PENDING)
  failureReason String?
  transactionId String?           @unique
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([userId, status])
}

enum ContestStatus {
  UPCOMING
  LIVE
  ENDED
}

enum ContestVisibility {
  PUBLIC
  PRIVATE
}

// Each entry gets its own isolated virtual wallet + holdings, seeded from
// startingBalance at join and traded only within `symbols` - decoupled from
// the user's real Wallet/Holding so contests can't leak into (or be leaked
// into by) normal trading.
model Contest {
  id                  String            @id @default(cuid())
  name                String
  startAt             DateTime
  endAt               DateTime
  startingBalance     Decimal           @default(100000) @db.Decimal(18, 2)
  symbols             String[]
  status              ContestStatus     @default(UPCOMING)
  visibility          ContestVisibility @default(PUBLIC)
  prize               String?
  imageUrl            String?
  inviteCode          String?           @unique
  ownerId             String?
  owner               User?             @relation("ContestOwner", fields: [ownerId], references: [id])
  // Presence of historicalStartDate marks this contest as a "past event"
  // replay - historicalDates is the resolved, ordered list of historical
  // trading dates (one per real contest day) populated once at creation.
  // Null/empty means an ordinary contest trading at live prices, unchanged.
  historicalStartDate DateTime?         @db.Date
  historicalDates     DateTime[]        @db.Date
  // Optional rules (services/contestRules.ts): how many different stocks a
  // player may hold, and the most any one stock may be of their net worth.
  maxHoldings         Int?
  maxPositionPercent  Int?
  // Caps the number of players; a duel is a private contest with 2.
  maxEntries          Int?
  isDuel              Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  entries ContestEntry[]

  @@index([visibility, startAt])
  @@index([ownerId])
}

// A shared cache of historical daily closes, keyed by symbol+date rather
// than contest - so multiple replay contests reusing the same symbol/date
// range don't refetch or duplicate storage.
model ContestHistoricalPrice {
  id     String   @id @default(cuid())
  symbol String
  date   DateTime @db.Date
  close  Decimal  @db.Decimal(18, 4)

  @@unique([symbol, date])
}

model ContestEntry {
  id            String   @id @default(cuid())
  contestId     String
  contest       Contest  @relation(fields: [contestId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  joinedAt      DateTime @default(now())
  balance       Decimal  @db.Decimal(18, 2)
  finalRank     Int?
  finalNetWorth Decimal? @db.Decimal(18, 2)

  holdings     ContestHolding[]
  transactions ContestTransaction[]

  @@unique([contestId, userId])
}

model ContestHolding {
  id             String       @id @default(cuid())
  contestEntryId String
  contestEntry   ContestEntry @relation(fields: [contestEntryId], references: [id])
  symbol         String
  quantity       Int
  avgBuyPrice    Decimal      @db.Decimal(18, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([contestEntryId, symbol])
}

model ContestTransaction {
  id             String       @id @default(cuid())
  contestEntryId String
  contestEntry   ContestEntry @relation(fields: [contestEntryId], references: [id])
  symbol         String
  side           Side
  quantity       Int
  price          Decimal      @db.Decimal(18, 4)
  total          Decimal      @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
}

enum AlertDirection {
  ABOVE
  BELOW
}

model PriceAlert {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  symbol      String
  targetPrice Decimal        @db.Decimal(18, 4)
  direction   AlertDirection
  triggered   Boolean        @default(false)
  triggeredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// Stocks a player has starred on the Market page, in the order they added them.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
}

// Net worth at each weekday's close (jobs/dailySnapshot.ts), for the
// Portfolio page's equity curve. Weekly results live in WeeklySnapshot.
model DailySnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  netWorth  Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Learn page quests the player has completed (services/quests.ts holds the
// definitions). Sticky: a quest stays done even if the condition later lapses.
model QuestCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  completedAt DateTime @default(now())

  @@unique([userId, questId])
}

enum PracticeStatus {
  ACTIVE
  FINISHED
}

// A solo replay of a past market episode (services/practice.ts), stepped one
// trading day at a time by the player. Its own cash and holdings, priced from
// the ContestHistoricalPrice cache; never touches the main wallet, contests or
// leaderboards.
model PracticeSession {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId    String
  dates         DateTime[]        @db.Date
  dayIndex      Int               @default(0)
  balance       Decimal           @default(100000) @db.Decimal(18, 2)
  status        PracticeStatus    @default(ACTIVE)
  finalNetWorth Decimal?          @db.Decimal(18, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  holdings      PracticeHolding[]
  trades        PracticeTrade[]

  @@index([userId, status])
}

model PracticeHolding {
  id          String          @id @default(cuid())
  sessionId   String
  session     PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  symbol      String
  quantity    Int
  avgBuyPrice Decimal         @db.Decimal(18, 4)

  @@unique([sessionId, symbol])
}

model PracticeTrade {
  id        String          @id @default(cuid())
  sessionId String
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  symbol    String
  side      Side
  quantity  Int
  price     Decimal         @db.Decimal(18, 4)
  total     Decimal         @db.Decimal(18, 2)
  charges   Decimal         @db.Decimal(18, 2)
  dayIndex  Int
  createdAt DateTime        @default(now())

  @@index([sessionId])
}

enum PredictionDirection {
  UP
  DOWN
}

// The daily call (services/predictions.ts): will NIFTY 50 close up or down
// on `date` (an IST trading day)? Resolved after that day's close; `correct`
// stays null for an unresolved call or a flat close.
model Prediction {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime            @db.Date
  direction  PredictionDirection
  resolved   Boolean             @default(false)
  correct    Boolean?
  indexClose Decimal?            @db.Decimal(18, 2)
  createdAt  DateTime            @default(now())

  @@unique([userId, date])
  @@index([resolved, date])
}
