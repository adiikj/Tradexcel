PORT =
# Neon (serverless Postgres). Prefer the pooled endpoint - the "-pooler" host
# Neon gives you - because it survives a compute suspend and doesn't run into
# the per-branch connection cap as easily. connection_limit and pool_timeout
# are added automatically if they aren't already on the URL.
DATABASE_URL=
# The site's own public origin. Used for the links in the weekly recap email.
# Defaults to the shared SITE_URL constant, so it only needs setting when the
# site is hosted somewhere else.
SITE_URL=https://www.tradexcel.site
# The origins allowed to call the API, comma separated. The frontend's own
# origin has to be in here or every request from the browser is refused.
CORS_ORIGIN =
ACCESS_TOKEN_SECRET =
REFRESH_TOKEN_SECRET =
ACCESS_TOKEN_EXPIRY =
REFRESH_TOKEN_EXPIRY =
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# "production" also marks the auth cookies Secure.
NODE_ENV=
# Pino's log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
CLOUDINARY_NAME =
CLOUDINARY_API_KEY =
CLOUDINARY_API_SECRET =
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_EXPIRY=2h
# Chat assistant (all optional). The model downloads from Hugging Face on first
# boot (~90 MB) and is cached with the card index under CHAT_CACHE_DIR.
CHAT_ENABLED=true
CHAT_MODEL_ID=adiikj/tradexcel-assistant-encoder
CHAT_MODEL_REVISION=bc4669e1e2db1f32c732b7b62d577031c1bb1b2a
CHAT_CACHE_DIR=
